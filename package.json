{
  "name": "megabrain",
  "version": "0.1.0",
  "description": "Drop-in OpenAI/Anthropic-compatible proxy and CLI that cut LLM token spend with semantic caching, tier routing and a live savings dashboard. Bilingual PT/EN, dark and light.",
  "type": "module",
  "bin": {
    "megabrain": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js start",
    "test": "vitest run"
  },
  "keywords": ["ai", "llm", "token-savings", "router", "cache", "cli"],
  "license": "MIT",
  "author": "David Arsénio Martins",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.7.0"
  }
}
